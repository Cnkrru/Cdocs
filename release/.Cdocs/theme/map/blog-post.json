{
  "extends": "base",
  "sections": [
    {
      "component": "Breadcrumb",
      "if": "breadcrumb",
      "sections": [
        {
          "component": "CrumbLink",
          "each": "breadcrumb.links"
        },
        {
          "component": "CrumbText",
          "each": "breadcrumb.texts"
        },
        {
          "component": "CrumbCurrent",
          "if": "breadcrumb.current"
        }
      ]
    },
    {
      "html": "{{body}}\n"
    },
    {
      "component": "Pager",
      "if": "pager.show",
      "sections": [
        {
          "component": "PagerPrev",
          "if": "pager.prev.show"
        },
        {
          "component": "PagerPrevDisabled",
          "if": "pager.prev.hidden"
        },
        {
          "component": "PagerNext",
          "if": "pager.next.show"
        },
        {
          "component": "PagerNextDisabled",
          "if": "pager.next.hidden"
        }
      ]
    }
  ]
}
