{
  "extends": "base",
  "sections": [
    {
      "component": "Breadcrumb",
      "if": "breadcrumb",
      "sections": [
        {
          "component": "CrumbLink",
          "each": "breadcrumb.links"
        },
        {
          "component": "CrumbText",
          "each": "breadcrumb.texts"
        },
        {
          "component": "CrumbCurrent",
          "if": "breadcrumb.current"
        }
      ]
    },
    {
      "component": "BlogList",
      "sections": [
        {
          "component": "BlogCard",
          "each": "blog_posts"
        },
        {
          "component": "BlogPager",
          "if": "blog_pager.show",
          "sections": [
            {
              "component": "BlogPrev",
              "if": "blog_pager.prev_href"
            },
            {
              "component": "BlogPageCur",
              "if": "blog_pager.cur"
            },
            {
              "component": "BlogPageNum",
              "each": "blog_pager.pages"
            },
            {
              "component": "BlogNext",
              "if": "blog_pager.next_href"
            }
          ]
        }
      ]
    }
  ]
}
