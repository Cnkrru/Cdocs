{
  "extends": "base",
  "sections": [
    {
      "html": "<section class=\"paper-archive-head\">\n  <h1 class=\"paper-archive-title\">归档</h1>\n  <p class=\"paper-archive-sub\">所有文章，按发布时间倒序</p>\n</section>\n"
    },
    {
      "component": "ArticleList",
      "sections": [
        {
          "component": "ArticleCard",
          "each": "blog_posts"
        }
      ]
    },
    {
      "component": "ArticlePager",
      "if": "blog_pager.show",
      "sections": [
        {
          "component": "BlogPrev",
          "if": "blog_pager.prev_href"
        },
        {
          "component": "BlogPageCur",
          "if": "blog_pager.cur"
        },
        {
          "component": "BlogPageNum",
          "each": "blog_pager.pages"
        },
        {
          "component": "BlogNext",
          "if": "blog_pager.next_href"
        }
      ]
    }
  ]
}