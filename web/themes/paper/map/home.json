{
  "extends": "base",
  "sections": [
    {
      "html": "<section class=\"paper-hero\">\n  <h1>{{hero.title}}</h1>\n"
    },
    {
      "html": "  <p class=\"paper-hero-sub\">{{hero.subtitle}}</p>\n"
    },
    {
      "html": "  <p class=\"paper-hero-meta\"><a href=\"feed.xml\" rel=\"alternate\">RSS</a> · <a href=\"blog/\">归档</a> · <a href=\"tags/\">标签</a></p>\n</section>\n"
    },
    {
      "html": "<section class=\"paper-feed\">\n  <h2 class=\"paper-feed-title\">最新文章 <a href=\"blog/\" class=\"paper-feed-cta\">归档 →</a></h2>\n"
    },
    {
      "component": "ArticleList",
      "sections": [
        {
          "component": "ArticleCard",
          "each": "blog_posts"
        }
      ]
    },
    {
      "html": "</section>\n"
    },
    {
      "component": "ArticlePager",
      "if": "blog_pager.show",
      "sections": [
        {
          "component": "BlogPrev",
          "if": "blog_pager.prev_href"
        },
        {
          "component": "BlogNext",
          "if": "blog_pager.next_href"
        }
      ]
    }
  ]
}