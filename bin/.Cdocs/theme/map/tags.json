{
  "extends": "base",
  "sections": [
    {
      "component": "Breadcrumb",
      "if": "breadcrumb",
      "sections": [
        {
          "component": "CrumbLink",
          "each": "breadcrumb.links"
        },
        {
          "component": "CrumbText",
          "each": "breadcrumb.texts"
        },
        {
          "component": "CrumbCurrent",
          "if": "breadcrumb.current"
        }
      ]
    },
    {
      "component": "TagOverview",
      "sections": [
        {
          "component": "TagItem",
          "each": "tags"
        }
      ]
    }
  ]
}
